---
title: "Portfolio feed"
summary: "Recent portfolio entries from this Eleventy boilerplate."
permalink: "/portfolio/feed.xml"
---
{% set feedBaseUrl = site.absoluteUrl or site.url %}
{% set feedItems = collections.portfolioItems.slice(0, 25) %}
{% set feedAuthorName = site.authorName or site.copyrightOwner or site.name %}
{% set feedAuthorEmail = site.authorEmail or site.email %}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ (site.name + " " + title) | xmlEscape }}</title>
  <subtitle>{{ summary | xmlEscape }}</subtitle>
  <link href="{{ feedBaseUrl }}{{ permalink }}" rel="self"/>
  <link href="{{ feedBaseUrl }}/portfolio/"/>
  <updated>{{ feedItems | rssLastUpdatedDate }}</updated>
  <id>{{ feedBaseUrl }}{{ "/portfolio/" }}</id>
  <author>
    <name>{{ feedAuthorName | xmlEscape }}</name>
    {% if feedAuthorEmail %}<email>{{ feedAuthorEmail | xmlEscape }}</email>{% endif %}
  </author>
  {% for item in feedItems %}
    {% set absoluteItemUrl %}{{ feedBaseUrl }}{{ item.url | url }}{% endset %}
    {% set itemAuthorName = item.data.authorName or feedAuthorName %}
    {% set itemAuthorEmail = item.data.authorEmail or feedAuthorEmail %}
    {% set itemSummary = item.data.summary or item.data.metaDesc or item.data.lede or (item.templateContent | excerpt(280)) %}
    <entry>
      <title>{{ item.data.title | xmlEscape }}</title>
      <link href="{{ absoluteItemUrl }}"/>
      <updated>{{ (item.data.date or item.date) | rssDate }}</updated>
      <id>{{ absoluteItemUrl }}</id>
      <author>
        <name>{{ itemAuthorName | xmlEscape }}</name>
        {% if itemAuthorEmail %}<email>{{ itemAuthorEmail | xmlEscape }}</email>{% endif %}
      </author>
      {% if itemSummary %}<summary>{{ itemSummary | xmlEscape }}</summary>{% endif %}
    </entry>
  {% endfor %}
</feed>
